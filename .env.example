# ==============================================================================
# Ledger Vault — Institutional Document Custody & Control System
# Environment Variable Documentation & Template
# ==============================================================================

# Application Environment: "development" | "production" | "test"
# In production, strict checks refuse to boot if default or missing secrets are detected.
ENV=development

# Project & Service Identifiers
PROJECT_NAME="Ledger Vault"
VERSION="1.0.0"

# JWT Session Authentication Secret
# Must be at least 32 cryptographically random characters in production.
SECRET_KEY=insecure-dev-secret-key-change-in-prod-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# AES-256-GCM Master Encryption Key
# Used for encrypting all documents at rest.
# Must be a 64-character hexadecimal string representing 32 raw bytes.
# Example generation: openssl rand -hex 32
AES_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database Connection URI
# Development default: local SQLite database via async driver
# Production default: PostgreSQL asyncpg URI
# e.g.: postgresql+asyncpg://user:pass@localhost:5432/ledger_vault
DATABASE_URL=sqlite+aiosqlite:///./ledger_vault.db

# Storage Directory Path
# Location where encrypted ciphertext (.enc) files reside. Plaintext is never stored here.
STORAGE_DIR=./vault_storage

# Frontend Origin & CORS Domain White-list
FRONTEND_URL=http://localhost:5173

# Redis Rate Limiting Connection URI
# In development, gracefully falls back to an in-memory sliding-window log if Redis is unavailable.
REDIS_URL=redis://localhost:6379/0

# SMTP / Email Delivery
# In development, routes to local Mailpit service (SMTP port 1025, Web UI http://localhost:8025)
# In production, configure corporate SMTP relay or transactional mailer.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=security@ledger-vault.internal

# Cloudflare Turnstile Anti-Bot CAPTCHA
# Development keys use Cloudflare's official always-pass test credentials:
# Secret key: 1x0000000000000000000000000000000AA
# Site key:   1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
